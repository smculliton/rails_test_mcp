<tr id="<%= dom_id(todo) %>" class="border-b border-zinc-900 hover:bg-zinc-900/40 transition-colors group">
  <td class="px-4 py-3 w-12">
    <%= form_with model: todo do |f| %>
      <%= f.check_box :completed,
          onchange: "this.form.requestSubmit()",
          class: "w-4 h-4 rounded border-zinc-600 bg-zinc-800 cursor-pointer accent-emerald-500",
          id: "todo_completed_#{todo.id}" %>
    <% end %>
  </td>
  <td class="px-4 py-3">
    <span class="<%= todo.completed? ? 'text-zinc-600 line-through' : 'text-zinc-200' %> transition-colors">
      <%= todo.title %>
    </span>
  </td>
  <td class="px-4 py-3">
    <% if todo.completed? %>
      <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 bg-emerald-950 border border-emerald-900 px-2 py-0.5 rounded">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>done
      </span>
    <% else %>
      <span class="inline-flex items-center gap-1.5 text-xs text-zinc-400 bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">
        <span class="w-1.5 h-1.5 rounded-full bg-zinc-600"></span>pending
      </span>
    <% end %>
  </td>
  <td class="px-4 py-3 text-right">
    <div class="flex items-center justify-end gap-3 opacity-0 group-hover:opacity-100 transition-opacity">
      <%= link_to "edit", edit_todo_path(todo), class: "text-xs text-zinc-500 hover:text-zinc-200 transition-colors" %>
      <%= button_to "delete", todo, method: :delete,
          class: "text-xs text-zinc-700 hover:text-red-400 transition-colors cursor-pointer bg-transparent border-0 p-0 font-mono",
          form: { data: { turbo_confirm: "delete \"#{todo.title}\"?" } } %>
    </div>
  </td>
</tr>
