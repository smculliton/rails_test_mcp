<% content_for :title, "todos" %>

<div class="flex items-center justify-between mb-8">
  <div>
    <h1 class="text-xl font-bold text-zinc-100 tracking-tight">todos</h1>
    <p class="text-xs text-zinc-500 mt-1">
      <%= @todos.count %> total ·
      <span class="text-emerald-500"><%= @todos.count(&:completed?) %> done</span> ·
      <span class="text-zinc-400"><%= @todos.count { |t| !t.completed? } %> pending</span>
    </p>
  </div>
  <%= link_to new_todo_path, class: "flex items-center gap-2 text-sm bg-zinc-900 hover:bg-zinc-800 border border-zinc-700 hover:border-zinc-600 text-zinc-200 px-4 py-2 rounded transition-colors" do %>
    <span class="text-emerald-400 font-bold">+</span> new todo
  <% end %>
</div>

<% if @todos.empty? %>
  <div class="border border-dashed border-zinc-800 rounded-lg py-16 text-center">
    <p class="text-zinc-600 text-sm font-mono">// no todos yet</p>
    <p class="text-zinc-700 text-xs mt-2">ask claude to add one via MCP, or <%= link_to "create one here", new_todo_path, class: "text-zinc-500 hover:text-zinc-300 underline underline-offset-2" %></p>
  </div>
<% else %>
  <div class="border border-zinc-800 rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-zinc-800 bg-zinc-900/50">
          <th class="px-4 py-3 w-12"></th>
          <th class="text-left px-4 py-3 text-xs text-zinc-500 font-medium">title</th>
          <th class="text-left px-4 py-3 text-xs text-zinc-500 font-medium w-28">status</th>
          <th class="px-4 py-3 text-xs text-zinc-500 font-medium w-28 text-right">actions</th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: "todo_row", collection: @todos, as: :todo %>
      </tbody>
    </table>
  </div>
<% end %>
