<% content_for :title, "todos" %>

<div class="flex items-center justify-between mb-8">
  <div>
    <h1 class="text-xl font-bold text-zinc-100 tracking-tight">todos</h1>
    <p class="text-xs text-zinc-500 mt-1">
      <%= @todos.count %> total ·
      <span class="text-emerald-500"><%= @todos.count(&:completed?) %> done</span> ·
      <span class="text-zinc-400"><%= @todos.count { |t| !t.completed? } %> pending</span>
    </p>
  </div>
  <%= link_to new_todo_path, class: "flex items-center gap-2 text-sm bg-zinc-900 hover:bg-zinc-800 border border-zinc-700 hover:border-zinc-600 text-zinc-200 px-4 py-2 rounded transition-colors" do %>
    <span class="text-emerald-400 font-bold">+</span> new todo
  <% end %>
</div>

<% if @todos.empty? %>
  <div class="border border-dashed border-zinc-800 rounded-lg py-16 text-center">
    <p class="text-zinc-600 text-sm font-mono">// no todos yet</p>
    <p class="text-zinc-700 text-xs mt-2">ask claude to add one via MCP, or <%= link_to "create one here", new_todo_path, class: "text-zinc-500 hover:text-zinc-300 underline underline-offset-2" %></p>
  </div>
<% else %>
  <div class="border border-zinc-800 rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-zinc-800 bg-zinc-900/50">
          <th class="text-left px-4 py-3 text-xs text-zinc-500 font-medium w-12">#</th>
          <th class="text-left px-4 py-3 text-xs text-zinc-500 font-medium">title</th>
          <th class="text-left px-4 py-3 text-xs text-zinc-500 font-medium w-28">status</th>
          <th class="px-4 py-3 text-xs text-zinc-500 font-medium w-28 text-right">actions</th>
        </tr>
      </thead>
      <tbody>
        <% @todos.each do |todo| %>
          <tr class="border-b border-zinc-900 hover:bg-zinc-900/40 transition-colors group">
            <td class="px-4 py-3 text-zinc-600 text-xs"><%= todo.id %></td>
            <td class="px-4 py-3">
              <span class="<%= todo.completed? ? 'text-zinc-600 line-through' : 'text-zinc-200' %>">
                <%= todo.title %>
              </span>
            </td>
            <td class="px-4 py-3">
              <% if todo.completed? %>
                <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 bg-emerald-950 border border-emerald-900 px-2 py-0.5 rounded">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>done
                </span>
              <% else %>
                <span class="inline-flex items-center gap-1.5 text-xs text-zinc-400 bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded">
                  <span class="w-1.5 h-1.5 rounded-full bg-zinc-600"></span>pending
                </span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-3 opacity-0 group-hover:opacity-100 transition-opacity">
                <%= link_to "edit", edit_todo_path(todo), class: "text-xs text-zinc-500 hover:text-zinc-200 transition-colors" %>
                <%= button_to "delete", todo, method: :delete, class: "text-xs text-zinc-700 hover:text-red-400 transition-colors cursor-pointer bg-transparent border-0 p-0 font-mono", form: { data: { turbo_confirm: "delete \"#{todo.title}\"?" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
